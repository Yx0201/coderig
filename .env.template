# ollama OpenAI 兼容端点
# 本地部署时 BASE_URL 指向 ollama 的 /v1，ENDPOINT 拼在后面组成完整请求地址
# 实际请求地址 = `${BASE_URL}${ENDPOINT}` = http://localhost:11434/v1/chat/completions
BASE_URL=http://localhost:11434/v1
ENDPOINT=/chat/completions

# API Key
# ollama 本地不校验 key，但客户端要求该字段非空，填任意字符串即可
API_KEY=your_api_key_here

# 模型名称
# 通过 `ollama list` 查看本地已拉取的模型 tag，例如 qwen3:4b
MODEL=qwen3:4b
