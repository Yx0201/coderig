# DeepSeek 官方端点(OpenAI 兼容)
# 实际请求地址 = `${BASE_URL}${ENDPOINT}` = https://api.deepseek.com/chat/completions
BASE_URL=https://api.deepseek.com
ENDPOINT=/chat/completions

# API Key:https://platform.deepseek.com/api_keys 申请
API_KEY=your_api_key_here

# 模型名称,如 deepseek-v4-flash
MODEL=deepseek-v4-flash

# 上下文窗口预算(token),达 80% 触发 history 压缩。
# DeepSeek 官方窗口 1M token,直接用满;换小窗口模型时相应调小
CONTEXT_WINDOW_TOKENS=1000000

# 单次回答输出上限(max_tokens)。官方上限 384K,但不顶格:
# 压缩阈值 80% → prompt 最多 800k,顶格 384K 会让 prompt+max_tokens 越过 1M 窗口。
# 32768 保证"prompt ≤ 80% 窗口 ⇒ prompt + max_tokens ≤ 窗口",需要长输出时可上调
MAX_OUTPUT_TOKENS=32768
