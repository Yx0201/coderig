# ollama OpenAI 兼容端点
# 本地部署时 BASE_URL 指向 ollama 的 /v1，ENDPOINT 拼在后面组成完整请求地址
# 实际请求地址 = `${BASE_URL}${ENDPOINT}` = http://localhost:11434/v1/chat/completions
BASE_URL=http://localhost:11434/v1
ENDPOINT=/chat/completions

# API Key
# ollama 本地不校验 key，但客户端要求该字段非空，填任意字符串即可
API_KEY=your_api_key_here

# 模型名称
# 通过 `ollama list` 查看本地已拉取的模型 tag，例如 qwen3:4b
MODEL=qwen3:4b

# 上下文窗口预算(token)，用于触发 history 压缩(达 80% 即压缩)
# 注意这是"工作集预算"而非物理窗口：有效物理窗口 = min(模型原生窗口, ollama 运行时分配，
# 看 `ollama ps` 的 CONTEXT 列)，但预算应取得更小——长上下文注意力稀释 + 每轮重发全量的
# prefill 延迟，都让"用满物理窗口"得不偿失。换云端大模型后按其能力调大
CONTEXT_WINDOW_TOKENS=32768
